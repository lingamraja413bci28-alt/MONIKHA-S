if __name__ == '__main__':
    students = []
    # Input handling
    for _ in range(int(input())):
        name = input()
        score = float(input())
        students.append([name, score])

    # 1. Get all unique scores and sort them
    scores = sorted(list(set([x[1] for x in students])))
    
    # 2. Identify the second lowest grade
    second_lowest_grade = scores[1]
    
    # 3. Filter students with that grade and sort their names
    results = sorted([x[0] for x in students if x[1] == second_lowest_grade])
    
    # 4. Print each name on a new line
    for name in results:
        print(name)
