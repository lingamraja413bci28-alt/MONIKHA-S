#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    // Dynamically allocate memory to comfortably fit the constraints
    char *s = malloc(1024 * sizeof(char));
    
    // Read the entire line including spaces up to a newline character
    if (scanf("%[^\n]%*c", s) == 1) {
        // Tokenize the string using spaces as delimiters
        char *token = strtok(s, " ");
        
        while (token != NULL) {
            printf("%s\n", token);
            token = strtok(NULL, " ");
        }
    }
    
    free(s);
    return 0;
}
